<Page x:Class="Turnierprogramm2.Views.RoundViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Turnierprogramm2.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RoundViewPage">

    <Grid>
        <DataGrid Name="dg" AutoGenerateColumns="False"  CanUserAddRows="False" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}"  CanUserDeleteRows="False" >
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kind 1" Binding="{Binding Doppel1.Kind}"/>
                <DataGridTextColumn Header="Erwachsener 1" Binding="{Binding Doppel1.Adult}"/>
                <DataGridTextColumn Header="Sätze" Binding="{Binding Result}" IsReadOnly="False"/>
                <DataGridTextColumn Header="Kind 2" Binding="{Binding Doppel2.Kind}"/>
                <DataGridTextColumn Header="Erwachsener 2" Binding="{Binding Doppel2.Adult}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
