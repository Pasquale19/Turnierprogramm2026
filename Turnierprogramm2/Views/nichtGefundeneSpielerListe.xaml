<Window x:Class="Turnierprogramm2.Views.nichtGefundeneSpielerListe"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Turnierprogramm2.Views"
        mc:Ignorable="d"
        Title="nicht gefundene Spieler" Height="450" Width="300">
    <Grid Name="LayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <DataGrid Name="dgUsers2" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Player[0]}" HorizontalAlignment="Right"
                  Grid.Column="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kind" Binding="{Binding}" IsReadOnly="True" />
                  </DataGrid.Columns>
        </DataGrid>
        <DataGrid Name="dgUsers" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Player[1]}" HorizontalAlignment="Left"
                  Grid.Column="1"                  >
            <DataGrid.Columns>
       
                <DataGridTextColumn Header="Erwachsener" Binding="{Binding}" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
