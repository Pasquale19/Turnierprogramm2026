<UserControl x:Class="Turnierprogramm2.Views.RoundCollectionViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Turnierprogramm2.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Name="LayoutRoot">
        <TabControl ItemsSource="{Binding RoundVMCollection}">
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <local:RoundViewControl Games="{Binding Games}" NextRound="{Binding nextRound}"
                                            isFinished="{Binding isFinished}" readGamesCmd="{Binding readGamesCmd}"
                                            randomResultCmd="{Binding randomResultCmd}"
                                            checkGamesCmd="{Binding checkGamesCmd}"
                                            Runde="{Binding Runde}"></local:RoundViewControl>
                                    </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</UserControl>
