<Window x:Class="Turnierprogramm2.Views.InputView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Turnierprogramm2.Views"
        xmlns:local2="clr-namespace:WpfCustomControlLibrary.Buttons;assembly=WpfCustomControlLibrary"
        mc:Ignorable="d"
        Title="InputView" Height="450" Width="800">
    <Grid Name="LayoutRoot">
        <Grid.Resources>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="2 1" />
                <Setter Property="BorderBrush" Value="LightGray" />
                <Setter Property="Validation.ErrorTemplate">
                    <Setter.Value>
                        <ControlTemplate>
                            <StackPanel>
                                <AdornedElementPlaceholder />
                                <ItemsControl Margin="0 5 0 0"
                                    FontSize="12"
                                    ItemsSource="{Binding}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="Red" Text="{Binding ErrorContent}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <StackPanel>
                                <Border Padding="{TemplateBinding Padding}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                    <ScrollViewer x:Name="PART_ContentHost" />
                                </Border>
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" ></RowDefinition>
            <RowDefinition Height="30" ></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*" ></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="Rundenanzahl:" />
        <TextBox Grid.Column="1" Margin="20 0 0 0"
                Text="{Binding anzRunden, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Anzahl GewinnSätze:" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="20 0 0 0"
                Text="{Binding anzGewinnsätze, UpdateSourceTrigger=PropertyChanged,FallbackValue=19}" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="maximale Satzpunkte:" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="20 0 0 0"
                Text="{Binding maxPkt, UpdateSourceTrigger=PropertyChanged,FallbackValue=19}" />
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="3">
            <Button Grid.Row="0" Grid.Column="3" Command="{Binding importMeldungenCmd}" ToolTip="Lädt die Meldungen, wenn im Ordner 'Meldungen' die Datei 'meldungen.txt' liegt">
                Meldungen Laden
            </Button>
            <Button Grid.Row="0" Grid.Column="3" Command="{Binding browseMeldungenCmd}" ToolTip="Lädt die Meldungen aus einer beliebigen '.txt' Datei">
                Meldungen lokal laden
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
            <Button  Command="{Binding exportMeldungenCmd}" ToolTip="Speichert die Meldungen unter 'Meldungen/meldungen.txt'">
                Meldungen Speichern
            </Button>
            <Button  Command="{Binding browseMeldungenExportCmd}" ToolTip="Speichert die Meldungen in einer beliebigen '.txt' Datei">Meldungen lokal Speichern</Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
            <Button  HorizontalAlignment="Center"
                ToolTip="Startet das Turnier! \n Ein Turnier kann nur gestartet werden, wenn kein Kinder- oder Elternname doppelt vergeben wird und kein Name leer ist"
            Command="{Binding startTurnier}"
            Content="starte Turnier"
            IsEnabled="{Binding CanCreate}" Cursor="Hand" Width="200">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#32a852" />
                        <Setter Property="Foreground" Value="white" />
                        <Setter Property="Cursor" Value="Hand" />

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    TextBlock.Foreground="{TemplateBinding Foreground}">
                                        <Grid>
                                            <ContentPresenter Content="{TemplateBinding Content}" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <EventTrigger.Actions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation
                                            Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                            To="#27753c"
                                            Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger.Actions>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <EventTrigger.Actions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation
                                            Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                            To="#32a852"
                                            Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger.Actions>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!--<local2:adornedButton Grid.Row="1" Grid.Column="3" Command="{Binding exportMeldungenCmd}" Description="Speichert die Liste in einer .txt Datei">Meldungen Speichern</local2:adornedButton>-->
            <Button Command="{Binding showErrorsCmd}" ToolTip="zeigt Fehler in MsgBox">zeige Fehler</Button>
        
        </StackPanel>

        <DataGrid Name="dgMeldung" Grid.Row="4" Grid.ColumnSpan="4" AutoGenerateColumns="False" CanUserAddRows="True" Margin="5" VerticalAlignment="Top"
  CanUserDeleteRows="True"  >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind.Name, Mode=TwoWay}"></DataGridTextColumn>
            <DataGridTextColumn Header="Level Kind" Binding="{Binding Kind.Level}"></DataGridTextColumn>
                <DataGridTextColumn Header="Name Erwachsener" Binding="{Binding Adult.Name}"></DataGridTextColumn>
                <DataGridTextColumn Header="Level Erwachsener" Binding="{Binding LevelAdult}"></DataGridTextColumn>
            </DataGrid.Columns>
           
        </DataGrid> 
    </Grid>
</Window>
