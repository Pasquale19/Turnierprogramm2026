<UserControl x:Class="Turnierprogramm2.UserControls.SpielerListe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Turnierprogramm2.UserControls"            
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
            >

    <Grid x:Name = "LayoutRoot" DataContext = "{Binding ElementName=parent}">
        <DataGrid Name="dgUsers" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Player}">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="ToolTip"
                    Value="Multi-sort: Click the first column, hold Shift, then click the second column." />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" IsReadOnly="True" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" />
                 <DataGridTextColumn Header="Siege" Binding="{Binding Siege}"/>
                <DataGridTextColumn Header="Punkte" Binding="{Binding Punkte}" />               
                <DataGridTextColumn Header="Sätze" Binding="{Binding Sets}"/>
                <DataGridTextColumn Header="Gegenpunkte" Binding="{Binding Gegenpunkte}"/>
                <DataGridTemplateColumn Header="Partner" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ListView  ItemsSource="{Binding Partner}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ID}" Width="25"/>
                                            <TextBlock Text="{Binding Name}" Width="120"/>                                        
                                    </StackPanel>
                                    </DataTemplate>
                                    
                                </ListView.ItemTemplate>
                                
                            </ListView>
                            
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
            <StackPanel.ToolTip>
                <TextBlock>
            Multi-sort: Click the first column,
            hold Shift, then click the second column.
                </TextBlock>
            </StackPanel.ToolTip>
            <Button Click="Button_Click_1" VerticalAlignment="Bottom">export Pdf</Button>
            <Button Click="Button_Click_Sort" VerticalAlignment="Bottom">Sort Rangliste</Button>
            <!--<Button Click="Button_Click_2" VerticalAlignment="Bottom">export Pdf</Button>-->
        </StackPanel>
    </Grid>
</UserControl>
